# F: (Samsung 860 DCT) -> library + NZBGet completed folder, mounted as /data
ROOT_MEDIA_PATH=F:\
# D: (Samsung 870 EVO) -> overflow library folders, mounted over /data/Movies and /data/Shows
OVERFLOW_MOVIES=D:\Movies
OVERFLOW_SHOWS=D:\Shows
PUID=1000
PGID=1000
TZ=Europe/Zurich

# Telegram bot used for free-space alerts (same bot as the WoL setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: extra chat IDs (comma-separated) allowed to use the command bot
TELEGRAM_ALLOWED_IDS=

# Jellyfin API key (Dashboard > API Keys) used by sleep-guard.ps1
JELLYFIN_API_KEY=

# wake-api Worker, used by status-push.ps1 to publish free space / now playing for the LilyGO display
WAKE_API_URL=https://wake-api.yourname.workers.dev
# Same value as ESP32_SECRET on the Worker (and WORKER_SECRET in the ESP32 config.h)
WAKE_API_SECRET=
