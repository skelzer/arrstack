# D: (Samsung 870 EVO) -> NZBGet staging + overflow library, mounted as /data
ROOT_MEDIA_PATH=D:\
# F: (Samsung 860 DCT) -> main library, mounted over /data/Radarr and /data/Sonarr
LIBRARY_MOVIES=F:\Radarr
LIBRARY_SHOWS=F:\Sonarr
PUID=1000
PGID=1000
TZ=Europe/Zurich

# Telegram bot used for free-space alerts (same bot as the WoL setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jellyfin API key (Dashboard > API Keys) used by sleep-guard.ps1
JELLYFIN_API_KEY=
